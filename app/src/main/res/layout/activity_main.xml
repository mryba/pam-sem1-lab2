<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/screen_title"
        android:textColor="@color/screen_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/name_label"
        android:textColor="@color/screen_text"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editTextName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/name_hint"
        android:inputType="textCapWords"
        android:minHeight="48dp"
        android:textColor="@color/screen_text"
        android:textColorHint="@color/screen_text" />

    <EditText
        android:id="@+id/editTextSurname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/surname_hint"
        android:inputType="textCapWords"
        android:minHeight="48dp"
        android:textColor="@color/screen_text"
        android:textColorHint="@color/screen_text" />

    <EditText
        android:id="@+id/editTextAge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/age_hint"
        android:inputType="number"
        android:minHeight="48dp"
        android:textColor="@color/screen_text"
        android:textColorHint="@color/screen_text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/category_title"
        android:textColor="@color/screen_text"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/radioGroupCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/radioCategoryFirst"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/category_first"
            android:textColor="@color/screen_text" />

        <RadioButton
            android:id="@+id/radioCategorySecond"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/category_second"
            android:textColor="@color/screen_text" />
    </RadioGroup>

    <Button
        android:id="@+id/buttonShowData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/button_background"
        android:text="@string/show_data"
        android:textColor="@color/button_text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/color_title"
        android:textColor="@color/screen_text"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/checkBoxRed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/red"
            android:textColor="@color/screen_text" />

        <CheckBox
            android:id="@+id/checkBoxGreen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/green"
            android:textColor="@color/screen_text" />

        <CheckBox
            android:id="@+id/checkBoxBlue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/blue"
            android:textColor="@color/screen_text" />
    </LinearLayout>

    <Button
        android:id="@+id/buttonGenerateColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/button_background"
        android:text="@string/generate_color"
        android:textColor="@color/button_text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/text_color_title"
        android:textColor="@color/screen_text"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/radioGroupTextColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/radioTextRed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/red"
            android:textColor="@color/screen_text" />

        <RadioButton
            android:id="@+id/radioTextGreen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/green"
            android:textColor="@color/screen_text" />

        <RadioButton
            android:id="@+id/radioTextBlue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/blue"
            android:textColor="@color/screen_text" />
    </RadioGroup>

    <TextView
        android:id="@+id/textViewColorLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/color_label"
        android:textColor="@color/screen_text"
        android:textSize="28sp"
        android:textStyle="bold" />

</LinearLayout>
